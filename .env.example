# Production (Vercel) — required
DATABASE_URL=
NEXTAUTH_URL=https://www.profindernow.com
NEXTAUTH_SECRET=
ADMIN_EMAILS=profinderofficiall@gmail.com

# Password-reset email (required for forgot-password in production)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional billing (leave empty until Stripe is verified)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=

# Optional AI email generation (OpenAI-compatible: OpenAI, Groq, DeepSeek, etc.)
# If set, email drafts use a grounded LLM call; otherwise the deterministic template is used.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
