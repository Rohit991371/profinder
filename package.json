{
  "name": "profinder",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prepare-bundled-sqlite.cjs && prisma generate && next build",
    "sync:academic": "tsx scripts/sync-academic-foundation.ts",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma db push && tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "seed:taxonomy": "tsx prisma/seed-taxonomy.ts",
    "import:universities": "tsx scripts/import-pipeline.ts",
    "test": "tsx --test src/lib/matching.test.ts src/lib/matching/engine.test.ts src/lib/billing/access.test.ts src/lib/admin-pagination.test.ts scripts/recover-sqlite-to-postgres.test.ts",
    "import:official": "tsx scripts/import-official-programs.ts",
    "audit:professors": "tsx scripts/audit-professor-duplicates.ts",
    "recover:preflight": "tsx scripts/recover-sqlite-to-postgres.ts --preflight",
    "recover:dry-run": "tsx scripts/recover-sqlite-to-postgres.ts --dry-run",
    "recover:validate-sqlite": "tsx scripts/validate-sqlite-recovery.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "mammoth": "^1.8.0",
    "next": "14.2.35",
    "next-auth": "^4.24.11",
    "nodemailer": "^6.9.16",
    "pdf-parse": "^1.1.1",
    "react": "^18",
    "react-dom": "^18",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.19.0",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
