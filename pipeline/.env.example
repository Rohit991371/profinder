# Copy to pipeline/.env and fill in. NEVER commit .env. Never paste these values into chats.
# Use letters+digits only in PG_PASSWORD (it is embedded in the URLs below).

# --- Docker Postgres (used by docker/docker-compose.yml) ---
PG_USER=pipeline
PG_PASSWORD=change-me-letters-and-digits
PG_DB=profinder_pipeline
PG_PORT=55432

# --- Pipeline connections (keep password/port in sync with the lines above) ---
PIPELINE_DATABASE_URL=postgresql://pipeline:change-me-letters-and-digits@localhost:55432/profinder_pipeline
APP_DATABASE_URL=postgresql://pipeline:change-me-letters-and-digits@localhost:55432/profinder_pipeline

# --- LLM: xAI Grok (confirm model name in xAI docs/console) ---
XAI_API_KEY=
XAI_MODEL=

# --- Data sources / discovery (optional until the iteration that needs them) ---
OPENALEX_API_KEY=
SERPER_API_KEY=
TAVILY_API_KEY=
PROXY_URL=
