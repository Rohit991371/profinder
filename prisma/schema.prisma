// PROFINDER — Database Schema
// Production uses PostgreSQL.
// Local dev can use SQLite if you temporarily switch the provider.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model University {
  id                  String   @id @default(cuid())
  name                String
  nameZh              String?
  country             String   @default("China")
  province            String?
  city                String?
  officialUrl         String?
  sourceUrl           String?
  description         String?
  agencyNumber        String?
  openAlexId          String?
  logoUrl             String?
  dataStatus          String   @default("unverified")
  dataSource          String?
  applicationUrl      String?
  applicationFee      String?
  applicationDeadline String?
  scholarshipUrl      String?
  scholarshipDeadline String?
  verifiedAt          DateTime?
  verificationStatus  String   @default("UNVERIFIED")
  lastCheckedAt       DateTime?
  confidence          Float?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  programs      Program[]
  professors    Professor[]
  scholarships  Scholarship[]
  colleges      College[]
  departments   Department[]
  applyItems    ApplyRequestItem[]
}

model Program {
  id                   String   @id @default(cuid())
  universityId         String
  degree               String
  major                String
  teachingLang         String?
  requirements         String?
  programUrl           String?
  deadline             String?
  openingDate          String?
  scholarshipDeadline  String?
  tuition              String?
  applicationFee       String?
  duration             String?
  englishReq           String?
  ielts                String?
  toefl                String?
  gpaRequirement       String?
  cscType              String?
  supervisorRequired   String?
  applicationUrl       String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  university           University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  academicFieldId      String?
  disciplineId         String?
  majorId              String?
  collegeId            String?
  departmentId         String?
  officialName         String?
  studyMode            String?
  degreeLevel          String?
  verificationStatus   String   @default("UNVERIFIED")
  lastCheckedAt        DateTime?
  lastVerifiedAt       DateTime?
  confidence           Float?
  sourceUrl            String?

  academicField        AcademicField? @relation(fields: [academicFieldId], references: [id], onDelete: SetNull)
  discipline           Discipline? @relation(fields: [disciplineId], references: [id], onDelete: SetNull)
  majorRef             Major? @relation(fields: [majorId], references: [id], onDelete: SetNull)
  college              College? @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  departmentRef        Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  researchAreas        ProgramResearchArea[]
  professorsRef        ProgramProfessor[]

  @@index([universityId])
  @@index([degree])
  @@index([major])
}

model Professor {
  id                String   @id @default(cuid())
  name              String
  universityId      String
  firstName         String?
  lastName          String?
  nameZh            String?
  position          String?
  school            String?
  department        String?
  country           String?
  email             String?
  profileUrl        String?
  personalWebsite   String?
  researchInterests String?
  researchKeywords  String?
  lab               String?
  publications      String?
  publicationCount  Int?
  orcid             String?
  openAlexId        String?
  semanticScholarId String?
  profileIsPersonal Boolean  @default(false)
  dataStatus        String   @default("unverified")
  dataSource        String?
  lastSyncedAt      DateTime?
  verifiedAt        DateTime?
  verificationStatus String  @default("UNVERIFIED")
  lastCheckedAt      DateTime?
  lastVerifiedAt     DateTime?
  confidence         Float?
  collegeId          String?
  departmentId       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  university        University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  researchAreas     ProfessorResearchArea[]
  applications      Application[]
  savedBy           SavedProfessor[]
  publicationRows   Publication[]
  sources           ProfessorSource[]
  topics            ProfessorTopic[]
  college            College? @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  departmentRef      Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  academicFields     ProfessorAcademicField[]
  disciplines        ProfessorDiscipline[]
  majors             ProfessorMajor[]
  programs           ProgramProfessor[]

  @@index([orcid])
  @@index([openAlexId])
  @@index([semanticScholarId])
  @@index([universityId])
}

model ResearchArea {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  keywords    String?
  parentId    String?
  createdAt   DateTime @default(now())

  professors  ProfessorResearchArea[]
  programs    ProgramResearchArea[]
}

model ProfessorResearchArea {
  professorId    String
  researchAreaId String

  professor      Professor    @relation(fields: [professorId], references: [id], onDelete: Cascade)
  researchArea   ResearchArea @relation(fields: [researchAreaId], references: [id], onDelete: Cascade)

  @@id([professorId, researchAreaId])
}

model Scholarship {
  id            String   @id @default(cuid())
  universityId  String?
  name          String
  type          String?
  requirements  String?
  deadline      String?
  officialUrl   String?
  advantages    String?
  coverage      String?
  dataStatus    String   @default("unverified")
  verificationStatus String @default("UNVERIFIED")
  lastCheckedAt DateTime?
  lastVerifiedAt DateTime?
  confidence    Float?
  createdAt     DateTime @default(now())

  university    University? @relation(fields: [universityId], references: [id], onDelete: SetNull)
}

model Student {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String
  name               String?
  degree             String?
  major              String?
  academicBackground String?
  researchInterests  String?
  skills             String?
  projects           String?
  cvText             String?
  preferredCountries String?
  preferredUniversities String?
  plan               String   @default("free")
  role               String   @default("student")
  resetToken         String?
  resetTokenExp      DateTime?
  nationality        String?
  gpa                String?
  englishTest        String?
  fundingGoals       String?
  matchCheckedAt     String?
  phone              String?
  resumeText         String?
  currentUniversity  String?
  graduationYear     String?
  academicLevel      String?
  publications       String?
  researchExperience String?
  researchMethods    String?
  tools              String?
  programmingLanguages String?
  researchKeywords   String?
  preferredResearchAreas String?
  targetDegreeLevel  String?
  intake             String?
  fundingPreference  String?
  fullyFundedPreference String?
  scholarshipPreference String?
  ielts              String?
  toefl              String?
  pte                String?
  englishProof       String?
  englishTestStatus  String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  applications       Application[]
  savedProfessors    SavedProfessor[]
  applyRequests      ApplyRequest[]
  subscription       Subscription?
  usageCounters      UsageCounter[]
}

model SavedProfessor {
  id          String   @id @default(cuid())
  studentId   String
  professorId String
  createdAt   DateTime @default(now())

  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  professor   Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)

  @@unique([studentId, professorId])
}

model Subscription {
  id                     String    @id @default(cuid())
  studentId              String    @unique
  plan                   String
  status                 String
  provider               String    @default("stripe")
  providerCustomerId     String?
  providerSubscriptionId String?   @unique
  priceId                String?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  student                Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model UsageCounter {
  id        String   @id @default(cuid())
  studentId String
  feature   String
  period    String
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, feature, period])
}

model BillingEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}

model Application {
  id            String   @id @default(cuid())
  studentId     String
  universityId  String?
  professorId   String?
  programId     String?
  scholarship          String?
  degree               String?
  programName          String?
  status               String   @default("Saved")
  contactStatus        String?
  deadline             String?
  followUpDate         String?
  scholarshipDeadline  String?
  applicationUrl       String?
  notes                String?
  documentsJson        String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  student       Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  professor     Professor? @relation(fields: [professorId], references: [id], onDelete: SetNull)
}

model Publication {
  id                    String   @id @default(cuid())
  professorId           String
  title                 String
  year                  Int?
  authors               String?
  venue                 String?
  citationCount         Int?
  abstract              String?
  doi                   String?
  openAlexWorkId        String?
  semanticScholarPaperId String?
  sourceUrl             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  professor             Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)

  @@index([professorId])
  @@index([doi])
  @@index([openAlexWorkId])
}

model ProfessorSource {
  id          String   @id @default(cuid())
  professorId String
  source      String
  externalId  String?
  sourceUrl   String?
  fetchedAt   DateTime @default(now())

  professor   Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)

  @@index([professorId])
  @@index([source, externalId])
}

model Topic {
  id             String   @id @default(cuid())
  name           String   @unique
  openAlexTopicId String?
  professors     ProfessorTopic[]
}

model ProfessorTopic {
  professorId String
  topicId     String
  professor   Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)
  topic       Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([professorId, topicId])
}

model AcademicField {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  sourceUrl   String?
  verificationStatus String @default("VERIFIED")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  disciplines Discipline[]
  programs    Program[]
  professors  ProfessorAcademicField[]
  aliases     AcademicAlias[]
  @@unique([name])
  @@index([verificationStatus])
}

model Discipline {
  id              String @id @default(cuid())
  academicFieldId String
  name            String
  slug            String @unique
  description     String?
  sourceUrl       String?
  verificationStatus String @default("PENDING_REVIEW")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  academicField AcademicField @relation(fields: [academicFieldId], references: [id], onDelete: Cascade)
  majors        Major[]
  programs      Program[]
  professors    ProfessorDiscipline[]
  aliases       AcademicAlias[]
  @@unique([academicFieldId, name])
  @@index([academicFieldId])
}

model Major {
  id              String @id @default(cuid())
  disciplineId    String
  name            String
  officialName    String?
  slug            String @unique
  description     String?
  sourceUrl       String?
  verificationStatus String @default("PENDING_REVIEW")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  discipline Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  programs   Program[]
  professors ProfessorMajor[]
  aliases    AcademicAlias[]
  @@unique([disciplineId, name])
  @@index([disciplineId])
}

model College {
  id              String @id @default(cuid())
  universityId    String
  name            String
  officialName    String?
  sourceUrl       String?
  verificationStatus String @default("PENDING_REVIEW")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  university University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  departments Department[]
  programs Program[]
  professors Professor[]
  @@unique([universityId, name])
  @@index([universityId])
}

model Department {
  id              String @id @default(cuid())
  universityId    String
  collegeId       String?
  name            String
  officialName    String?
  sourceUrl       String?
  verificationStatus String @default("PENDING_REVIEW")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  university University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  college College? @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  programs Program[]
  professors Professor[]
  @@unique([universityId, name])
  @@index([universityId])
}

model ProgramResearchArea {
  programId String
  researchAreaId String
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  researchArea ResearchArea @relation(fields: [researchAreaId], references: [id], onDelete: Cascade)
  @@id([programId, researchAreaId])
}

model ProgramProfessor {
  programId String
  professorId String
  relationship String?
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  professor Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)
  @@id([programId, professorId])
  @@index([professorId])
}

model ProfessorAcademicField {
  professorId String
  academicFieldId String
  professor Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)
  academicField AcademicField @relation(fields: [academicFieldId], references: [id], onDelete: Cascade)
  @@id([professorId, academicFieldId])
}

model ProfessorDiscipline {
  professorId String
  disciplineId String
  professor Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)
  discipline Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  @@id([professorId, disciplineId])
}

model ProfessorMajor {
  professorId String
  majorId String
  professor Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)
  major Major @relation(fields: [majorId], references: [id], onDelete: Cascade)
  @@id([professorId, majorId])
}

model AcademicAlias {
  id String @id @default(cuid())
  term String
  normalizedTerm String
  kind String
  academicFieldId String?
  disciplineId String?
  majorId String?
  academicField AcademicField? @relation(fields: [academicFieldId], references: [id], onDelete: Cascade)
  discipline Discipline? @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  major Major? @relation(fields: [majorId], references: [id], onDelete: Cascade)
  @@unique([normalizedTerm, kind])
  @@index([normalizedTerm])
}

model SourceRecord {
  id String @id @default(cuid())
  entityType String
  entityId String
  url String
  sourceType String
  verificationStatus String @default("PENDING_REVIEW")
  checkedAt DateTime?
  verifiedAt DateTime?
  confidence Float?
  httpStatus Int?
  contentHash String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([entityType, entityId])
  @@index([url])
}

model ChangeLog {
  id String @id @default(cuid())
  entityType String
  entityId String
  changeType String
  beforeJson String?
  afterJson String?
  sourceUrl String?
  detectedAt DateTime @default(now())
  reviewedAt DateTime?
  reviewedBy String?
  @@index([entityType, entityId])
  @@index([detectedAt])
}

model MatchFeedback {
  id           String   @id @default(cuid())
  studentId    String?
  query        String?
  professorId  String?
  programId    String?
  universityId String?
  vote         String
  reason       String?
  createdAt    DateTime @default(now())

  @@index([studentId])
  @@index([professorId])
}

model ApplyRequest {
  id               String   @id @default(cuid())
  studentId        String
  status           String   @default("draft")
  feeCents         Int      @default(3000)
  package          String   @default("pair")
  paymentStatus    String   @default("unpaid")
  paymentRef       String?
  studentNote      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  student          Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  items            ApplyRequestItem[]
  documents        ApplyDocument[]

  @@index([studentId])
}

model ApplyRequestItem {
  id                String    @id @default(cuid())
  requestId         String
  universityId      String
  status            String    @default("selected")
  preparationNote   String?
  studentApprovedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  request           ApplyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  university        University   @relation(fields: [universityId], references: [id], onDelete: Restrict)

  @@unique([requestId, universityId])
  @@index([requestId])
}

model ApplyDocument {
  id         String   @id @default(cuid())
  requestId  String
  kind       String
  name       String
  storedName String
  size       Int
  createdAt  DateTime @default(now())

  request    ApplyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}
