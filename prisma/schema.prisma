// PROFINDER — Database Schema
// Temporary: using SQLite (bundled prisma/dev.db) on Vercel while Neon is disconnected.
// Switch provider back to postgresql and restore DATABASE_URL when reconnecting Neon.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}
